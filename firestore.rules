
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    match /userProfiles/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /matches/{matchId} {
      // Allow all signed-in users to read and list matches
      // The application filters these matches by participantUserIds locally or via queries
      allow read, list: if isSignedIn();
      
      // Allow creation if the submittedByUserId matches the auth UID
      allow create: if isSignedIn() && request.resource.data.submittedByUserId == request.auth.uid;
      
      // Only allow the original submitter to edit or delete
      allow update, delete: if isSignedIn() && resource.data.submittedByUserId == request.auth.uid;
    }
  }
}
