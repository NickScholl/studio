/**
 * ShuttleScore Security Rules
 *
 * Updated: Simplified listing rules and removed redundant ID constraints to fix permission errors.
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Collection Rules ---

    match /userProfiles/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);
    }

    match /matches/{matchId} {
      // Allow listing for all signed-in users. 
      // Individual get is restricted to participants.
      allow list: if isSignedIn();
      
      allow get: if isSignedIn() && (
        request.auth.uid == resource.data.submittedByUserId || 
        request.auth.uid in resource.data.participantUserIds
      );
      
      // Allow creation if the user is the one submitting it
      allow create: if isSignedIn() && request.resource.data.submittedByUserId == request.auth.uid;
      
      // Only the submitter can modify or delete the match record
      allow update, delete: if isSignedIn() && resource.data.submittedByUserId == request.auth.uid;

      match /matchPlayerStats/{statsId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && (
          request.auth.uid == get(/databases/$(database)/documents/matches/$(matchId)).data.submittedByUserId
        );
      }
    }
  }
}
