
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    match /userProfiles/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /matches/{matchId} {
      // Explicitly allow both get and list for all signed-in users
      allow read, get, list: if isSignedIn();
      
      // Only allow creators to submit matches
      allow create: if isSignedIn() && request.resource.data.submittedByUserId == request.auth.uid;
      
      // Only the submitter can modify or delete their records
      allow update, delete: if isSignedIn() && resource.data.submittedByUserId == request.auth.uid;

      match /matchPlayerStats/{statsId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }
    }
  }
}
